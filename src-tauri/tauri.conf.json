{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astral",
  "version": "2.9.60",
  "identifier": "com.kevin.astral",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Astral",
        "label": "main",
        "width": 960,
        "height": 540,
        "minWidth": 200,
        "minHeight": 300,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Astral"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "astral"
        ]
      },
      "mobile": [
        {
          "scheme": "astral"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}